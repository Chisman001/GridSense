# GridSense ML / FastAPI (python-dotenv loads this from the repo root)
# Copy to `.env` and fill in real values. Never commit `.env`.

GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Comma-separated extra CORS origins for the FastAPI app.
# Localhost origins are already allowed by default.
FRONTEND_URL=http://localhost:3000
